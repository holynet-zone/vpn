import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { DesktopHomeView } from "../views/desktop_home.slint";
import { RouteView } from "../views/route.slint";
import { DesktopNodesView } from "../views/desktop_nodes.slint";
import { ShieldView } from "../views/shield.slint";
import { DesktopMoreView } from "../views/desktop_more.slint";
import { SplitView } from "../views/split.slint";
import { AboutView } from "../views/about.slint";
import { ProtoView } from "../views/proto.slint";
import { DevicesView } from "../views/devices.slint";

export component DesktopPageHost inherits VerticalLayout {
    property <bool> more-group: Screen.page == Page.more || Screen.page == Page.settings;

    if Screen.page == Page.home: DesktopHomeView {}
    if Screen.page == Page.route: RouteView {}
    if Screen.page == Page.nodes: DesktopNodesView {}
    if Screen.page == Page.shield: ShieldView {}
    if Screen.page == Page.split: SplitView {}
    if Screen.page == Page.about: AboutView {}
    if Screen.page == Page.proto: ProtoView {}
    if Screen.page == Page.devices: DevicesView {}
    if root.more-group: DesktopMoreView {}
}
