import { Theme } from "../theme.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { GlobeArc, GlobeDot } from "../models.slint";

component GlobeHit inherits TouchArea {
    in property <float> sc;
    in property <length> off-x;
    in property <length> off-y;
    property <length> lx;
    property <length> ly;
    property <length> dnx;
    property <length> dny;
    property <bool> moved-far;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            self.lx = self.mouse-x;
            self.ly = self.mouse-y;
            self.dnx = self.mouse-x;
            self.dny = self.mouse-y;
            self.moved-far = false;
        }
    }
    moved => {
        if (self.pressed && self.sc > 0) {
            if (abs(self.mouse-x - self.dnx) > 6px || abs(self.mouse-y - self.dny) > 6px) {
                self.moved-far = true;
            }
            AppState.globe-drag((self.mouse-x - self.lx) / self.sc / 1px, (self.mouse-y - self.ly) / self.sc / 1px);
            self.lx = self.mouse-x;
            self.ly = self.mouse-y;
        }
    }
    clicked => {
        if (self.sc > 0 && !self.moved-far) {
            AppState.globe-tap((self.off-x + self.mouse-x) / self.sc / 1px, (self.off-y + self.mouse-y) / self.sc / 1px);
        }
    }
    scroll-event(e) => {
        AppState.globe-zoom(e.delta-y / 1px);
        return accept;
    }
}

export component GlobeView inherits Rectangle {
    property <float> sc: self.width / 300px;
    height: self.width * 280 / 300;

    function arc-color(kind: int) -> brush {
        kind == 1 ? Theme.a1 : kind == 2 ? Theme.wn : kind == 3 ? Theme.ln : Theme.t2
    }
    function dot-fill(kind: int) -> brush {
        kind == 1 ? Theme.a1 : kind == 2 ? Theme.a2 : kind == 3 ? Theme.t : Theme.sf
    }
    function dot-stroke(kind: int) -> brush {
        kind == 1 ? Theme.a1 : kind == 2 ? Theme.wn : kind == 3 ? Theme.t : kind == 4 ? Theme.t2 : Theme.a1
    }
    property <length> cx: 150 * root.sc * 1px;
    property <length> cy: 140 * root.sc * 1px;
    property <length> rad: AppState.globe-radius * root.sc * 1px;

    Rectangle {
        x: (150 - AppState.globe-radius) * root.sc * 1px;
        y: (140 - AppState.globe-radius) * root.sc * 1px;
        width: AppState.globe-radius * 2 * root.sc * 1px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.sf;
        border-width: 1px;
        border-color: Theme.ln;
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 300;
        viewbox-height: 280;
        commands: AppState.globe-graticule;
        fill: transparent;
        stroke: Theme.ln;
        stroke-width: 0.5px;
        opacity: 0.7;
    }

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 300;
        viewbox-height: 280;
        commands: AppState.globe-land;
        fill: transparent;
        stroke: Theme.t2;
        stroke-width: 0.8px;
        opacity: 0.55;
    }

    for a in AppState.globe-arcs: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 300;
        viewbox-height: 280;
        commands: a.d;
        fill: transparent;
        stroke: arc-color(a.kind);
        stroke-width: a.width * 1px;
        opacity: a.kind == 3 ? 0.45 : a.kind == 1 ? 1.0 : 0.55;
    }

    for d in AppState.globe-dots: Rectangle {
        x: (d.x - d.r) * root.sc * 1px;
        y: (d.y - d.r) * root.sc * 1px;
        width: d.r * 2 * root.sc * 1px;
        height: self.width;
        border-radius: self.width / 2;
        background: dot-fill(d.fill);
        border-width: 2px;
        border-color: dot-stroke(d.stroke);
        opacity: d.dead ? 0.55 : 1.0;
    }

    for d in AppState.globe-dots: Text {
        x: d.lx * root.sc * 1px;
        y: d.ly * root.sc * 1px - 8px;
        text: d.is-me ? d.code : d.code + " " + d.rtt;
        font-size: d.is-exit ? 11px : 10px;
        font-weight: d.is-exit ? 700 : 600;
        font-family: "IBM Plex Mono";
        color: Theme.t;
    }

    ScaleRotateGestureHandler {
        started => {
            Screen.lock-scroll = true;
            AppState.globe-pinch-start();
        }
        updated => {
            AppState.globe-transform(self.scale, self.rotation / 1deg);
        }
        ended => {
            Screen.lock-scroll = false;
        }
        cancelled => {
            Screen.lock-scroll = false;
        }

        for f[i] in [
            0.348, 0.583, 0.726, 0.827, 0.899, 0.950, 0.982, 0.998,
            0.998, 0.982, 0.950, 0.899, 0.827, 0.726, 0.583, 0.348,
        ]: GlobeHit {
            sc: root.sc;
            width: 2 * f * root.rad;
            height: root.rad / 8;
            x: root.cx - f * root.rad;
            y: root.cy - root.rad + i * (root.rad / 8);
            off-x: self.x;
            off-y: self.y;
        }
    }
}
