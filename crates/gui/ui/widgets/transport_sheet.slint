import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { PillToggle } from "pill_toggle.slint";
import { BottomSheet } from "bottom_sheet.slint";

component RadioDot inherits Rectangle {
    in property <bool> on;
    width: 17px;
    height: 17px;
    border-radius: 8.5px;
    border-width: 1.5px;
    border-color: on ? Theme.a1 : Theme.ln;
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: on ? Theme.a1 : transparent;
    }
}

component TransportMeasure inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    in property <length> w;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 3px;
    Text { width: root.w; text: root.title; font-size: 12.5px; font-weight: 600; wrap: word-wrap; }
    Text { width: root.w; text: root.desc; font-size: 10.5px; wrap: word-wrap; }
}

export component TransportSheet inherits BottomSheet {
    open: Screen.transport-sheet;
    close => { Screen.close-transport-sheet(); }

    VerticalLayout {
        vertical-stretch: 0;
        padding-bottom: 10px;
        spacing: 4px;
        Text { text: Str.transport; font-size: 19px; font-weight: 800; letter-spacing: -0.4px; color: Theme.t; }
        Text { text: Str.transport-desc-hdr; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
    }

    Rectangle {
        vertical-stretch: 0;
        height: 62px;
        border-radius: 16px;
        background: Theme.sf2;
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text { text: Str.auto-title; font-size: 13px; font-weight: 600; color: Theme.t; }
                Text { text: Str.auto-hint; font-size: 11px; color: Theme.t2; wrap: word-wrap; }
            }
            Rectangle {}
            VerticalLayout {
                alignment: center;
                PillToggle {
                    on: AppState.auto-transport;
                    toggled => { AppState.set-auto-transport(!AppState.auto-transport); }
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 7px;
                for tr in AppState.transports: Rectangle {
                    height: tmeas.preferred-height;
                    border-radius: 16px;
                    background: tr.selected ? Theme.sf2 : transparent;
                    border-width: 1px;
                    border-color: tr.selected ? Theme.a1 : Theme.ln;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 30px;
                                border-radius: 9px;
                                background: Theme.sf2;
                                Text {
                                    text: tr.name;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: tr.selected ? Theme.a1 : Theme.t2;
                                    font-family: "IBM Plex Mono";
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text { text: tr.title; font-size: 12.5px; font-weight: 600; color: Theme.t; }
                            Text { text: tr.desc; font-size: 10.5px; color: Theme.t2; wrap: word-wrap; }
                        }
                        VerticalLayout { alignment: center; RadioDot { on: tr.selected; } }
                    }
                    TouchArea {
                        clicked => {
                            AppState.select-transport(tr.id);
                            Screen.close-transport-sheet();
                        }
                    }
                }
            }
        }
        tmeas := GridLayout {
            opacity: 0;
            for tr in AppState.transports: TransportMeasure {
                row: 0;
                col: 0;
                w: tmeas.width - 109px;
                title: tr.title;
                desc: tr.desc;
            }
        }
    }
}
