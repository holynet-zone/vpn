import { Theme, ThemeMode, Accent } from "../theme.slint";
import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { MobileShell } from "../shell/mobile_shell.slint";
import { SampleData } from "sample.slint";

export component PreviewShield inherits Window {
    width: 430px;
    height: 880px;
    background: Theme.page;
    SampleData {
        init => {
            Screen.wide = false;
            Screen.page = Page.shield;
            Theme.mode = ThemeMode.dark;
            Theme.accent = Accent.tide;
        }
    }
    MobileShell { width: 100%; height: 100%; }
}
