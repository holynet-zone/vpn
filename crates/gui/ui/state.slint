import { ConnStatus, ServerInfo, TransportInfo, CipherInfo, ChainStep, ToggleInfo, SplitAppRow, SplitModeRow, SplitDomainRow, SplitChip, DeviceInfo, KeyValue, PaletteCard, NodeRow, RouteHop, EdgeRow, PrioTab, RouteSeg, SpaceRow, Visibility, Factor, AddHopChip, ExtraExit, GlobeNode, GlobeArc, GlobeDot, RouteTab, PickMode, AddStep, LegalDocRow, DocSection, ProtoRow, ProtoOpt, MtuPreset, LangRow, ShieldIssue, HomeSeg, HomeHop } from "models.slint";
import { ThemeMode, Lang } from "theme.slint";

export global AppState {
    in property <ConnStatus> status: ConnStatus.off;

    in property <RouteTab> route-tab: RouteTab.auto;
    in property <bool> route-auto: true;
    in property <bool> route-manual: false;
    in property <bool> route-graph: false;
    in property <int> prio: 1;
    in property <[RouteSeg]> route-segs;
    in property <[PrioTab]> prios;
    in property <string> prio-effect;
    in property <string> plan-reason;

    in property <string> exit-code;
    in property <string> exit-city;
    in property <string> exit-meta;
    in property <string> exit-ping;

    in property <[RouteHop]> path-hops;
    in property <[RouteHop]> draft-hops;
    in property <[AddHopChip]> add-hop-list;
    in property <string> path-sum;
    in property <bool> path-estimated: false;
    in property <string> path-warn;
    in property <string> hops-count;
    in property <string> route-mode-label;
    in property <string> hr-total;
    in property <string> hr-unit;
    in property <string> hr-meta;
    in property <string> hr-via;
    in property <[HomeSeg]> hr-segs;
    in property <[HomeHop]> hr-hops;
    in property <[string]> chain-log;
    in property <bool> no-relays: false;
    in property <bool> has-relays: false;
    in property <bool> can-add-hop: true;
    in property <string> empty-title;
    in property <string> empty-body;
    in property <string> mode-color-tag;
    in property <bool> mode-optimal: true;
    in property <bool> has-extra-exits: false;
    in property <[ExtraExit]> extra-exits;
    in property <string> exits-count;
    in property <string> add-free-count;

    // Node picker (isServers pickFor)
    in property <PickMode> pick-mode: PickMode.none;
    in property <bool> pick-active: false;
    in property <bool> pick-rep: false;
    in property <string> nodes-title;
    in property <string> pick-hint;

    in property <[NodeRow]> node-list;
    in property <[EdgeRow]> edge-list;
    in property <string> topo-counts;
    in property <bool> probing: false;
    in property <string> probe-label;
    in property <[GlobeNode]> globe-nodes;
    in property <string> globe-graticule;
    in property <string> globe-land;
    in property <[GlobeArc]> globe-arcs;
    in property <[GlobeDot]> globe-dots;
    in property <float> globe-radius: 138;

    in property <[Visibility]> visibility;
    in property <[Factor]> factors;
    in property <string> privacy-note;

    // Shield (isShield) — issue-driven
    in property <[ShieldIssue]> sh-issues;
    in property <bool> sh-has-issues: false;
    in property <string> sh-issue-count;
    in property <string> sh-attention;
    in property <[ToggleInfo]> sh-leak;
    in property <[ToggleInfo]> sh-net;
    in property <string> grp-leak;
    in property <string> grp-net;
    in property <string> sh-home-title;
    in property <string> sh-home-sub;
    in property <int> sh-home-state;

    in property <bool> cold: false;
    in property <string> space-name;
    in property <string> space-note;
    in property <string> space-ctl;
    in property <string> space-count;
    in property <[SpaceRow]> space-rows;
    in property <bool> space-sheet-open: false;
    in property <bool> add-open: false;
    in property <AddStep> add-step: AddStep.idle;
    in property <string> parsed-name;
    in property <string> parsed-ctl;
    in property <string> parsed-note;
    in property <string> parsed-alg;
    in property <string> parsed-fp;
    in property <bool> can-add-space: true;

    in property <string> qr-exit-line;
    in property <string> qr-endpoint;
    in property <bool> qr-parsed: false;
    in property <bool> qr-shown: false;

    in property <string> server-code;
    in property <string> server-city;
    in property <string> server-meta;
    in property <string> server-ping;

    in property <string> transport-code;
    in property <string> transport-title;
    in property <string> transport-desc;
    in property <bool> auto-transport: true;

    in property <string> status-sub;
    in property <bool> banner-visible: false;
    in property <string> banner-text;

    in property <string> session-time: "—";
    in property <string> down-text: "—";
    in property <string> up-text: "—";
    in property <string> speed-now;
    in property <[float]> spark: [0.1, 0.1, 0.1];

    in property <int> privacy-score: 40;
    in property <bool> kill-on: true;
    in property <string> proto-summary;
    in property <string> cipher-name;
    in property <string> dev-summary;
    in property <string> split-summary;

    // Split tunneling (isSplit)
    in property <bool> split-on: true;
    in property <int> split-mode: 0;
    in property <string> split-lead;
    in property <string> split-off-note;
    in property <[SplitModeRow]> split-modes;
    in property <bool> split-sug-visible: false;
    in property <string> split-sug-text;
    in property <string> split-sug-btn;
    in property <[SplitChip]> split-sug;
    in property <bool> split-sys-on: false;
    in property <bool> split-has-sel: false;
    in property <[SplitAppRow]> split-sel;
    in property <string> split-sel-n;
    in property <string> split-sel-cap;
    in property <[SplitAppRow]> split-rest;
    in property <string> split-rest-n;
    in property <string> split-rest-cap;
    in property <bool> split-no-match: false;
    in property <string> split-no-match-text;
    in property <string> split-dom-cap;
    in property <string> split-dom-n;
    in property <[SplitDomainRow]> split-doms;
    in property <string> split-dom-hint;
    in property <bool> split-dom-hint-warn: false;
    in property <bool> split-add-enabled: false;
    in property <bool> split-show-risk: false;
    in-out property <string> split-query;
    in-out property <string> split-dom-in;

    // About (isAbout)
    in property <bool> about-doc-open: false;
    in property <string> about-back-label;
    in property <string> about-version-line;
    in property <string> about-pitch;
    in property <string> about-update-label;
    in property <int> about-update-state: 0;
    in property <string> gh-short;
    in property <[LegalDocRow]> about-legal;
    in property <string> doc-title;
    in property <string> doc-updated;
    in property <string> doc-tldr;
    in property <string> doc-url;
    in property <[DocSection]> doc-sections;

    // Proto settings (isProto)
    in property <bool> proto-list: true;
    in property <bool> proto-detail: false;
    in property <bool> proto-is-opts: false;
    in property <bool> proto-is-mtu: false;
    in property <string> proto-back-label;
    in property <string> proto-detail-summary;
    in property <string> proto-state-text;
    in property <bool> proto-state-modified: false;
    in property <[ProtoRow]> proto-grp-transport;
    in property <[ProtoRow]> proto-grp-crypto;
    in property <[ProtoRow]> proto-grp-conn;
    in property <bool> proto-changed: false;
