    in property <string> proto-detail-lead;
    in property <string> proto-detail-foot;
    in property <bool> proto-detail-has-foot: false;
    in property <[ProtoOpt]> proto-opts;
    in property <string> proto-cap-transport;
    in property <string> proto-cap-crypto;
    in property <string> proto-cap-conn;
    in property <string> proto-cap-diag;
    in property <string> proto-reset-label;
    in property <string> proto-sim-hint;
    in property <bool> mtu-auto: true;
    in property <string> mtu-val;
    in property <float> mtu-dec-op: 1.0;
    in property <float> mtu-inc-op: 1.0;
    in property <string> mtu-auto-hint;
    in property <string> mtu-auto-label;
    in property <[MtuPreset]> mtu-presets;
    in property <bool> mtu-probing: false;
    in property <bool> mtu-has-result: false;
    in property <string> mtu-probe-label;
    in property <string> mtu-result;
    in property <bool> mtu-can-apply: false;
    in property <string> mtu-bytes;
    in property <string> mtu-use;

    in property <[ServerInfo]> servers;
    in property <[TransportInfo]> transports;
    in property <[CipherInfo]> ciphers;
    in property <[ChainStep]> chain;
    in property <[ToggleInfo]> toggles;
    in property <[DeviceInfo]> devices;
    in property <[KeyValue]> proto-rows;
    in property <[PaletteCard]> palettes;
    in property <[LangRow]> lang-rows;

    in-out property <string> query;

    callback toggle-connect();
    callback select-server(string);
    callback select-transport(string);
    callback select-cipher(int);
    callback flip-toggle(string);
    callback shield-fix(int);
    callback set-auto-transport(bool);
    callback query-changed(string);
    callback smart-pick();
    callback simulate();

    callback select-palette(int);
    callback set-mode(ThemeMode);
    callback set-lang(Lang);
    callback select-lang-idx(int);

    callback select-route-tab(RouteTab);
    callback set-prio(int);
    callback apply-route();
    callback hop-up(int);
    callback hop-down(int);
    callback hop-reorder(int, int);
    callback hop-drop(int);
    callback hop-swap();
    callback add-hop(string);
    callback reset-draft();
    callback fill-fast();
    callback draft-from-plan();
    callback reprobe();
    callback pick-node(string);
    callback select-exit(string);
    callback open-add-hop();
    callback open-add-exit();
    callback cancel-pick();
    callback remove-picked();
    callback hop-replace(int);
    callback drop-exit(string);
    callback globe-drag(float, float);
    callback globe-zoom(float);
    callback globe-pinch-start();
    callback globe-transform(float, float);
    callback globe-tap(float, float);

    callback open-spaces();
    callback close-spaces();
    callback select-space(string);
    callback leave-space();
    callback open-add-space();
    callback close-add-space();
    callback parse-cfg();
    callback fail-cfg();
    callback reset-cfg();
    callback join-parsed();

    callback qr-parse();
    callback qr-reset();
    callback qr-reveal();

    callback split-toggle();
    callback split-set-mode(int);
    callback split-sug-apply();
    callback split-sug-dismiss();
    callback split-set-query(string);
    callback split-sys-toggle();
    callback split-flip-app(string);
    callback split-add-domain();
    callback split-drop-domain(string);
    callback split-set-dom-in(string);

    callback about-open();
    callback about-check-update();
    callback about-open-doc(int);
    callback about-back();
    callback open-url(string);

    callback proto-open(int);
    callback proto-back();
    callback proto-pick(int);
    callback proto-reset();
    callback proto-mtu-auto-flip();
    callback proto-mtu-dec();
    callback proto-mtu-inc();
    callback proto-mtu-preset(int);
    callback proto-mtu-probe();
    callback proto-mtu-apply();
