import { ConnStatus, ServerInfo, TransportInfo, CipherInfo, ChainStep, ToggleInfo, SplitApp, DeviceInfo, KeyValue, PaletteCard, NodeRow, RouteHop, EdgeRow, PrioTab, RouteSeg, SpaceRow, Visibility, Factor, AddHopChip, GlobeNode, RouteTab, AddStep } from "models.slint";
import { ThemeMode, Lang } from "theme.slint";

export global AppState {
    in property <ConnStatus> status: ConnStatus.off;

    in property <RouteTab> route-tab: RouteTab.auto;
    in property <bool> route-auto: true;
    in property <bool> route-manual: false;
    in property <bool> route-graph: false;
    in property <int> prio: 1;
    in property <[RouteSeg]> route-segs;
    in property <[PrioTab]> prios;
    in property <string> prio-effect;
    in property <string> plan-reason;

    in property <string> exit-code;
    in property <string> exit-city;
    in property <string> exit-meta;
    in property <string> exit-ping;

    in property <[RouteHop]> path-hops;
    in property <[RouteHop]> draft-hops;
    in property <[AddHopChip]> add-hop-list;
    in property <string> path-sum;
    in property <bool> path-estimated: false;
    in property <string> path-warn;
    in property <string> hops-count;
    in property <string> route-mode-label;
    in property <[string]> chain-log;
    in property <bool> no-relays: false;
    in property <bool> has-relays: false;
    in property <bool> can-add-hop: true;
    in property <string> empty-title;
    in property <string> empty-body;

    in property <[NodeRow]> node-list;
    in property <[EdgeRow]> edge-list;
    in property <string> topo-counts;
    in property <bool> probing: false;
    in property <string> probe-label;
    in property <[GlobeNode]> globe-nodes;

    in property <[Visibility]> visibility;
    in property <[Factor]> factors;
    in property <string> privacy-note;

    in property <bool> cold: false;
    in property <string> space-name;
    in property <string> space-note;
    in property <string> space-ctl;
    in property <string> space-count;
    in property <[SpaceRow]> space-rows;
    in property <bool> space-sheet-open: false;
    in property <bool> add-open: false;
    in property <AddStep> add-step: AddStep.idle;
    in property <string> parsed-name;
    in property <string> parsed-ctl;
    in property <string> parsed-note;
    in property <string> parsed-alg;
    in property <string> parsed-fp;
    in property <bool> can-add-space: true;

    in property <string> qr-exit-line;
    in property <string> qr-endpoint;
    in property <bool> qr-parsed: false;
    in property <bool> qr-shown: false;

    in property <string> server-code;
    in property <string> server-city;
    in property <string> server-meta;
    in property <string> server-ping;

    in property <string> transport-code;
    in property <string> transport-title;
    in property <string> transport-desc;
    in property <bool> auto-transport: true;

    in property <string> status-sub;
    in property <bool> banner-visible: false;
    in property <string> banner-text;

    in property <string> session-time: "—";
    in property <string> down-text: "—";
    in property <string> up-text: "—";
    in property <string> speed-now;
    in property <[float]> spark: [0.1, 0.1, 0.1];

    in property <int> privacy-score: 40;
    in property <bool> kill-on: true;
    in property <string> proto-summary;
    in property <string> cipher-name;
    in property <string> dev-summary;
    in property <string> split-summary;

    in property <[ServerInfo]> servers;
    in property <[TransportInfo]> transports;
    in property <[CipherInfo]> ciphers;
    in property <[ChainStep]> chain;
    in property <[ToggleInfo]> toggles;
    in property <[SplitApp]> apps;
    in property <[DeviceInfo]> devices;
    in property <[KeyValue]> proto-rows;
    in property <[PaletteCard]> palettes;

    in-out property <string> query;

    callback toggle-connect();
    callback select-server(string);
    callback select-transport(string);
    callback select-cipher(int);
    callback flip-toggle(string);
    callback flip-app(int);
    callback set-auto-transport(bool);
    callback query-changed(string);
    callback smart-pick();
    callback simulate();

    callback select-palette(int);
    callback set-mode(ThemeMode);
    callback set-lang(Lang);

    callback select-route-tab(RouteTab);
    callback set-prio(int);
    callback apply-route();
    callback hop-up(int);
    callback hop-down(int);
    callback hop-drop(int);
    callback hop-swap();
    callback add-hop(string);
    callback reset-draft();
    callback fill-fast();
    callback draft-from-plan();
    callback reprobe();
    callback pick-node(string);
    callback select-exit(string);

    callback open-spaces();
    callback close-spaces();
    callback select-space(string);
    callback leave-space();
    callback open-add-space();
    callback close-add-space();
    callback parse-cfg();
    callback fail-cfg();
    callback reset-cfg();
    callback join-parsed();

    callback qr-parse();
    callback qr-reset();
    callback qr-reveal();
}
