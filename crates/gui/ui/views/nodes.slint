import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { SignalBars } from "../widgets/signal_bars.slint";
import { ScreenTitle, IconTag } from "../widgets/tiles.slint";

export component NodesView inherits VerticalLayout {
    spacing: 18px;

    ScreenTitle { text: AppState.nodes-title; }

    if AppState.pick-active: Rectangle {
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.a1;
        HorizontalLayout {
            padding: 12px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            Text {
                text: AppState.pick-hint;
                font-size: 11.5px;
                color: Theme.t2;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if AppState.pick-rep: Rectangle {
                horizontal-stretch: 0;
                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    Text { text: Str.hop-remove; font-size: 11px; font-weight: 600; color: Theme.dg; vertical-alignment: center; }
                }
                TouchArea { clicked => { AppState.remove-picked(); } }
            }
            Rectangle {
                horizontal-stretch: 0;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.ln;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 11px;
                    padding-right: 11px;
                    Text { text: Str.cancel; font-size: 11px; font-weight: 600; color: Theme.t2; vertical-alignment: center; }
                }
                TouchArea { clicked => { AppState.cancel-pick(); } }
            }
        }
    }

    Card {
        elevated: false;
        border-radius: 16px;
        height: 48px;
        HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            spacing: 10px;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 13px;
                    height: 13px;
                    border-radius: 6.5px;
                    border-width: 1.5px;
                    border-color: Theme.t2;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                if AppState.query == "": Text {
                    text: Str.search-ph;
                    color: Theme.t2;
                    font-size: 14px;
                    x: 0;
                    vertical-alignment: center;
                }
                input := TextInput {
                    text <=> AppState.query;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    font-size: 14px;
                    color: Theme.t;
                    single-line: true;
                    width: 100%;
                    height: 100%;
                    edited => { AppState.query-changed(self.text); }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 8px;
        for s in AppState.node-list: Card {
            elevated: false;
            border-radius: 18px;
            stroke: s.selected ? Theme.a1 : Theme.ln;
            opacity: s.node-state == 2 ? 0.5 : 1.0;
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                IconTag { text: s.code; width: 36px; height: 36px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 7px;
                        Text { text: s.city; font-size: 13.5px; font-weight: 600; color: Theme.t; }
                        Text { text: s.tag; font-size: 9.5px; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
                    }
                    Text { text: s.meta; font-size: 11px; color: Theme.t2; font-family: "IBM Plex Mono"; }
                }
                Rectangle {}
                VerticalLayout { alignment: center; SignalBars { quality: s.quality; } }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: s.ping;
                        width: 52px;
                        horizontal-alignment: right;
                        font-size: 11px;
                        color: s.node-state == 1 ? Theme.wn : s.node-state == 2 ? Theme.t2 : Theme.ok;
                        font-family: "IBM Plex Mono";
                    }
                }
            }
            TouchArea { clicked => { if (s.alive) { AppState.select-exit(s.id); } } }
        }
    }
}
