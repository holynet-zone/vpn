import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { ConnStatus, Page } from "../models.slint";
import { Card, Chip, Chevron } from "../widgets/card.slint";
import { StatusOrb } from "../widgets/status_orb.slint";
import { Sparkline } from "../widgets/sparkline.slint";
import { IconTag } from "../widgets/tiles.slint";

component StatBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Theme.sf2;
    border-radius: 14px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: root.label;
            font-size: 9.5px;
            font-weight: 500;
            letter-spacing: 1px;
            color: Theme.t2;
            font-family: "IBM Plex Mono";
        }
        Text {
            text: root.value;
            font-size: 15px;
            font-weight: 600;
            color: Theme.t;
            font-family: "IBM Plex Mono";
        }
    }
}

export component HomeView inherits VerticalLayout {
    property <brush> status-color: AppState.status == ConnStatus.on ? Theme.ok
        : AppState.status == ConnStatus.connecting ? Theme.a1 : Theme.t2;
    spacing: 20px;

    VerticalLayout {
        spacing: 6px;
        Text {
            text: AppState.status == ConnStatus.on ? Str.status-on
                : AppState.status == ConnStatus.connecting ? Str.status-connecting : Str.status-off;
            horizontal-alignment: center;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 1.4px;
            color: root.status-color;
            font-family: "IBM Plex Mono";
        }
        Text {
            text: AppState.status == ConnStatus.on ? Str.title-on
                : AppState.status == ConnStatus.connecting ? Str.title-connecting : Str.title-off;
            horizontal-alignment: center;
            font-size: 29px;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.t;
            wrap: word-wrap;
        }
        Text {
            text: AppState.status == ConnStatus.on ? AppState.status-sub
                : AppState.status == ConnStatus.connecting ? Str.sub-connecting : Str.sub-off;
            horizontal-alignment: center;
            font-size: 13px;
            color: Theme.t2;
            wrap: word-wrap;
        }
    }

    if AppState.banner-visible: Card {
        stroke: Theme.wn;
        HorizontalLayout {
            padding: 14px;
            spacing: 11px;
            Rectangle {
                width: 7px;
                height: 7px;
                y: 5px;
                border-radius: 3.5px;
                background: Theme.wn;
                vertical-stretch: 0;
            }
            VerticalLayout {
                spacing: 3px;
                Text { text: Str.banner-title; font-size: 12.5px; font-weight: 700; color: Theme.wn; }
                Text { text: AppState.banner-text; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
            }
        }
    }

    StatusOrb {
        status: AppState.status;
        label: AppState.status == ConnStatus.on ? Str.btn-on
            : AppState.status == ConnStatus.connecting ? "…" : Str.btn-off;
        transport-code: AppState.transport-code;
        clicked => { AppState.toggle-connect(); }
    }

    // transport
    Card {
        HorizontalLayout {
            padding: 16px;
            spacing: 13px;
            Rectangle {
                width: 46px;
                height: 34px;
                border-radius: 11px;
                background: Theme.sf2;
                vertical-stretch: 0;
                Text {
                    text: AppState.transport-code;
                    color: root.status-color;
                    font-size: 11px;
                    font-weight: 700;
                    font-family: "IBM Plex Mono";
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text { text: Str.transport; font-size: 13.5px; font-weight: 700; color: Theme.t; }
                Text { text: AppState.transport-title; font-size: 11.5px; color: Theme.t2; overflow: elide; }
            }
            Rectangle {}
            VerticalLayout {
                alignment: center;
                Chip {
                    text: AppState.auto-transport ? Str.auto-pick : Str.manual-pick;
                    text-color: AppState.auto-transport ? Theme.a1 : Theme.t2;
                    stroke: AppState.auto-transport ? Theme.a1 : Theme.ln;
                }
            }
            VerticalLayout { alignment: center; Chevron {} }
        }
        TouchArea { clicked => { Screen.open-transport-sheet(); } }
    }

    // server
    Card {
        HorizontalLayout {
            padding: 16px;
            spacing: 13px;
            IconTag { text: AppState.server-code; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: AppState.server-city; font-size: 14px; font-weight: 700; color: Theme.t; }
                Text { text: AppState.server-meta; font-size: 12px; color: Theme.t2; }
            }
            Rectangle {}
            VerticalLayout {
                alignment: center;
                Text { text: AppState.server-ping; font-size: 11px; color: Theme.ok; font-family: "IBM Plex Mono"; }
            }
            VerticalLayout { alignment: center; Chevron {} }
        }
        TouchArea { clicked => { Screen.go(Page.nodes); } }
    }

    // live traffic
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Text { text: Str.live-traffic; font-size: 12px; font-weight: 600; color: Theme.t2; }
                Rectangle {}
                Text { text: AppState.speed-now; font-size: 11px; color: Theme.t2; font-family: "IBM Plex Mono"; }
            }
            Sparkline {
                height: 46px;
                values: AppState.spark;
                active: AppState.status == ConnStatus.on;
            }
            HorizontalLayout {
                spacing: 8px;
                StatBox { label: Str.session; value: AppState.session-time; }
                StatBox { label: Str.down; value: AppState.down-text; }
                StatBox { label: Str.up; value: AppState.up-text; }
            }
        }
    }
}
