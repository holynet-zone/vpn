import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { RouteHop, ExtraExit } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle } from "../widgets/tiles.slint";
import { GlobeView } from "../widgets/globe.slint";

export component GradBtn inherits Rectangle {
    in property <string> label;
    in property <length> weight: 13px;
    callback clicked();
    horizontal-stretch: 1;
    height: 46px;
    border-radius: 15px;
    background: @linear-gradient(135deg, Theme.a1, Theme.a2);
    Text {
        text: root.label;
        font-size: root.weight;
        font-weight: 700;
        color: Theme.on;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component GhostBtn inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.t2;
    in property <brush> stroke: Theme.ln;
    callback clicked();
    horizontal-stretch: 1;
    height: 46px;
    border-radius: 15px;
    background: Theme.sf;
    border-width: 1px;
    border-color: stroke;
    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: root.tint;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component StepBtn inherits Rectangle {
    in property <string> glyph;
    in property <float> op: 1.0;
    callback clicked();
    width: 24px;
    height: 18px;
    border-radius: 6px;
    background: Theme.sf;
    opacity: op;
    Text { text: glyph; font-size: 11px; color: Theme.t2; }
    TouchArea { clicked => { root.clicked(); } }
}

component Chev inherits Rectangle {
    width: 7px;
    height: 7px;
    opacity: 0.6;
    Path {
        width: 7px;
        height: 7px;
        stroke: Theme.t2;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        commands: "M 1 0.5 L 6 3.5 L 1 6.5";
    }
}

component DraftHopCard inherits Rectangle {
    in property <RouteHop> hop;
    in property <int> idx;
    border-radius: 14px;
    background: Theme.sf2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: hop.is-exit ? Theme.a1 : Theme.sf;
                if !hop.is-exit: Text {
                    text: hop.num;
                    font-size: 10.5px;
                    font-family: "IBM Plex Mono";
                    color: Theme.t2;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 4px;
                alignment: center;
                HorizontalLayout {
                    spacing: 7px;
                    Text {
                        text: hop.label;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.t;
                        overflow: elide;
                    }
                    if hop.is-exit: Text {
                        text: "EXIT";
                        font-size: 9px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        font-family: "IBM Plex Mono";
                        color: Theme.a1;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: hop.code; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; }
                    Text {
                        text: hop.rtt;
                        font-size: 10.5px;
                        font-family: "IBM Plex Mono";
                        color: hop.rtt-warn ? Theme.wn : Theme.t2;
                    }
                }
            }
            TouchArea {
                clicked => {
                    if (hop.is-exit) {
                        AppState.hop-swap();
                    } else {
                        AppState.hop-replace(idx);
                    }
                }
            }
        }
        if !hop.is-exit: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                StepBtn { glyph: "▲"; op: hop.can-up ? 1.0 : 0.25; clicked => { AppState.hop-up(idx); } }
                StepBtn { glyph: "▼"; op: hop.can-down ? 1.0 : 0.25; clicked => { AppState.hop-down(idx); } }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.ln;
                    Text { text: "✕"; font-size: 12px; color: Theme.t2; }
                    TouchArea { clicked => { AppState.hop-drop(idx); } }
                }
            }
        }
        if hop.is-exit: VerticalLayout { alignment: center; Chev {} }
    }
}

component ExtraExitCard inherits Rectangle {
    in property <ExtraExit> item;
    border-radius: 14px;
    background: Theme.sf2;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 12px;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 22px; height: 22px; border-radius: 11px; background: Theme.a1; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;
            alignment: center;
            HorizontalLayout {
                spacing: 7px;
                Text { text: item.label; font-size: 14px; font-weight: 600; color: Theme.t; overflow: elide; }
                Text {
                    text: "EXIT";
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 0.8px;
                    font-family: "IBM Plex Mono";
                    color: Theme.a1;
                    vertical-alignment: center;
                }
                Rectangle {}
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: item.code; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; }
                Text { text: item.lat; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                Text { text: "✕"; font-size: 13px; color: Theme.t2; }
                TouchArea { clicked => { AppState.drop-exit(item.id); } }
            }
        }
    }
}

component AddRow inherits Rectangle {
    in property <string> label;
    in property <string> count;
    callback clicked();
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.ln;
    HorizontalLayout {
        padding: 12px;
        padding-left: 13px;
        padding-right: 13px;
        spacing: 11px;
        Text { text: "+"; width: 18px; font-size: 14px; font-weight: 600; color: Theme.a1; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: root.label; font-size: 12px; font-weight: 600; color: Theme.a1; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.count; font-size: 10px; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.ln;
}

export component RouteView inherits VerticalLayout {
    spacing: 16px;

    ScreenTitle { text: Str.route; }

    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppState.hops-count; font-size: 12px; font-weight: 600; color: Theme.t2; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: 999px;
                    border-width: 1px;
                    border-color: AppState.mode-optimal ? Theme.ok : Theme.a1;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        Text {
                            text: AppState.route-mode-label;
                            font-size: 9.5px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            font-family: "IBM Plex Mono";
                            color: AppState.mode-optimal ? Theme.ok : Theme.a1;
                        }
                    }
                }
                Text { text: AppState.path-sum; font-size: 13px; font-weight: 600; font-family: "IBM Plex Mono"; color: Theme.ok; vertical-alignment: center; }
            }

            Rectangle {
                height: 42px;
                border-radius: 12px;
                background: Theme.sf2;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    for p[i] in AppState.prios: Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 9px;
                        background: p.selected ? Theme.sf : transparent;
                        Text { text: p.name; font-size: 11px; font-weight: 600; color: p.selected ? Theme.t : Theme.t2; }
                        TouchArea { clicked => { AppState.set-prio(i); } }
                    }
                }
            }

            Divider {}

            Rectangle {
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.ln;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 9px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; border-width: 2px; border-color: Theme.t2; }
                    }
                    Text { text: Str.first-hop-mask; font-size: 11px; color: Theme.t2; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: AppState.transport-code; font-size: 10px; font-weight: 700; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
                }
            }

            if AppState.no-relays: Rectangle {
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.wn;
                VerticalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    Text { text: AppState.empty-title; font-size: 12px; font-weight: 700; color: Theme.wn; }
                    Text { text: AppState.empty-body; font-size: 11px; color: Theme.t2; wrap: word-wrap; }
                }
            }

            VerticalLayout {
                spacing: 6px;
                for hop[i] in AppState.draft-hops: DraftHopCard { hop: hop; idx: i; }
            }

            if AppState.has-extra-exits: VerticalLayout {
                spacing: 6px;
                for xe in AppState.extra-exits: ExtraExitCard { item: xe; }
            }

            if AppState.path-estimated: Text {
                text: AppState.path-warn;
                font-size: 11px;
                color: Theme.wn;
                wrap: word-wrap;
            }

            if AppState.can-add-hop: VerticalLayout {
                spacing: 6px;
                AddRow {
                    label: Str.add-hop;
                    count: AppState.add-free-count;
                    clicked => { AppState.open-add-hop(); }
                }
                AddRow {
                    label: Str.add-exit;
                    count: AppState.exits-count;
                    clicked => { AppState.open-add-exit(); }
                }
            }

            Divider {}

            Text { text: Str.route-graph-title; font-size: 12.5px; font-weight: 700; color: Theme.t; }
            HorizontalLayout { alignment: center; GlobeView {} }
            Text { text: Str.map-legend; font-size: 10px; color: Theme.t2; wrap: word-wrap; }
        }
    }
}
