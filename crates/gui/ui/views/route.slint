import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { RouteHop, ExtraExit } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle } from "../widgets/tiles.slint";
import { Ic } from "../widgets/icons.slint";
import { GlobeView } from "../widgets/globe.slint";
import { BouncyScroll } from "../widgets/bouncy_scroll.slint";

export component GradBtn inherits Rectangle {
    in property <string> label;
    in property <length> weight: 13px;
    callback clicked();
    horizontal-stretch: 1;
    height: 46px;
    border-radius: 15px;
    background: @linear-gradient(135deg, Theme.a1, Theme.a2);
    Text {
        text: root.label;
        font-size: root.weight;
        font-weight: 700;
        color: Theme.on;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component GhostBtn inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.t2;
    in property <brush> stroke: Theme.ln;
    callback clicked();
    horizontal-stretch: 1;
    height: 46px;
    border-radius: 15px;
    background: Theme.sf;
    border-width: 1px;
    border-color: stroke;
    Text {
        text: root.label;
        font-size: 12px;
        font-weight: 600;
        color: root.tint;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component HopBody inherits HorizontalLayout {
    in property <string> label;
    in property <string> code;
    in property <string> rtt;
    in property <bool> rtt-warn;
    in property <bool> is-exit;
    in property <string> mark;
    padding-left: 14px;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: root.is-exit ? Theme.a1 : Theme.sf;
            if !root.is-exit: Text { text: root.mark; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            spacing: 7px;
            Text { text: root.label; font-size: 14px; font-weight: 600; color: Theme.t; overflow: elide; }
            if root.is-exit: Text { text: "EXIT"; font-size: 9px; font-weight: 600; letter-spacing: 0.8px; font-family: "IBM Plex Mono"; color: Theme.a1; vertical-alignment: center; }
            Rectangle {}
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: root.code; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; }
            Text { text: root.rtt; font-size: 10.5px; font-family: "IBM Plex Mono"; color: root.rtt-warn ? Theme.wn : Theme.t2; }
        }
    }
}

// Строка черновика маршрута. Жесты повторяют дизайн v4: тап — заменить узел,
// зажатие (320мс) и протяжка вверх/вниз — reorder, свайп влево — удалить. Reorder
// хранит родитель (drag-idx/drag-dy), свайп — локально (swipe-dx). TouchArea
// статична (не двигается вместе с карточкой), поэтому координаты жеста стабильны.
component DraftHopCard inherits Rectangle {
    in property <RouteHop> hop;
    in property <int> idx;
    in property <int> drag-idx: -1;
    in property <length> drag-dy: 0px;
    in property <int> n-relays;
    callback start-drag(int);
    callback move-drag(length);
    callback end-drag();

    property <length> row-h: 62px;
    property <bool> dragging: root.drag-idx == root.idx && !root.hop.is-exit;
    property <float> target-i: max(0, min(root.n-relays - 1, root.drag-idx + round(root.drag-dy / root.row-h)));
    property <length> pressed-x: 0px;
    property <length> pressed-y: 0px;
    property <bool> pressing: false;
    // 0 — ось не выбрана, 1 — горизонталь (свайп), 2 — вертикаль (скролл)
    property <int> axis: 0;
    property <length> swipe-dx: 0px;
    property <bool> swipe-anim: false;
    property <length> swipe-threshold: min(110px, root.width * 0.33);

    width: 100%;
    height: 56px;
    clip: true;
    border-radius: 14px;
    y: root.drag-idx == -1 ? root.idx * root.row-h
        : root.dragging ? root.idx * root.row-h + root.drag-dy
        : (root.idx > root.drag-idx && root.idx <= root.target-i) ? (root.idx - 1) * root.row-h
        : (root.idx < root.drag-idx && root.idx >= root.target-i) ? (root.idx + 1) * root.row-h
        : root.idx * root.row-h;
    animate y { duration: root.dragging ? 0ms : 170ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    press-timer := Timer {
        interval: 320ms;
        running: root.pressing && root.axis == 0 && root.drag-idx == -1 && !root.hop.is-exit;
        triggered => {
            if (root.pressing && root.axis == 0 && !root.hop.is-exit) {
                root.start-drag(root.idx);
            }
        }
    }

    // Красный фон удаления, проявляется по мере свайпа.
    Rectangle {
        background: Theme.dg;
        border-radius: 14px;
        opacity: root.swipe-dx != 0px ? 1.0 : 0.0;
        HorizontalLayout {
            padding-left: 22px;
            padding-right: 22px;
            alignment: root.swipe-dx > 0px ? start : end;
            Text {
                text: Str.hop-remove;
                font-size: 12.5px;
                font-weight: 600;
                color: #ffffff;
                vertical-alignment: center;
            }
        }
    }

    // Видимая карточка: смещается по x при свайпе, приподнимается при drag.
    fg := Rectangle {
        x: root.swipe-dx;
        border-radius: 14px;
        background: root.dragging ? Theme.sf : Theme.sf2;
        border-width: root.dragging ? 1px : 0px;
        border-color: Theme.a1;
        drop-shadow-blur: root.dragging ? 20px : 0;
        drop-shadow-color: #0000004d;
        animate x { duration: root.swipe-anim ? 200ms : 0ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

        HorizontalLayout {
            padding-right: 14px;
            Rectangle {
                horizontal-stretch: 1;
                HopBody {
                    label: hop.label;
                    code: hop.code;
                    rtt: hop.rtt;
                    rtt-warn: hop.rtt-warn;
                    is-exit: hop.is-exit;
                    mark: hop.num;
                }
            }
            VerticalLayout {
                alignment: center;
                Ic { kind: hop.is-exit ? "chev-right" : "reorder"; size: hop.is-exit ? 12px : 15px; tint: Theme.t2; opacity: 0.6; }
            }
        }
    }

    body := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pressed-x = self.mouse-x;
                root.pressed-y = self.mouse-y;
                root.pressing = true;
                root.axis = 0;
                root.swipe-anim = false;
            }
            if (e.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.end-drag();
                } else if (root.axis == 1) {
                    root.swipe-anim = true;
                    if (abs(root.swipe-dx) > root.swipe-threshold) {
                        AppState.hop-drop(root.idx);
                    } else {
                        root.swipe-dx = 0px;
                    }
                    Screen.lock-scroll = false;
                } else if (root.pressing && root.axis == 0) {
                    if (root.hop.is-exit) {
                        AppState.hop-swap();
                    } else {
                        AppState.hop-replace(root.idx);
                    }
                }
                root.pressing = false;
            }
            if (e.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.end-drag();
                }
                if (root.axis == 1) {
                    root.swipe-anim = true;
                    root.swipe-dx = 0px;
                    Screen.lock-scroll = false;
                }
                root.pressing = false;
            }
        }
        moved => {
            if (root.dragging) {
                // Ограничиваем протяжку пределами списка релеев, чтобы карточку
                // нельзя было вытянуть выше первого или ниже последнего хопа.
                root.move-drag(max(-root.idx * root.row-h, min((root.n-relays - 1 - root.idx) * root.row-h, self.mouse-y - root.pressed-y)));
            } else {
                if (root.axis == 0 && (abs(self.mouse-x - root.pressed-x) > 8px || abs(self.mouse-y - root.pressed-y) > 8px)) {
                    root.axis = abs(self.mouse-x - root.pressed-x) > abs(self.mouse-y - root.pressed-y) ? 1 : 2;
                    if (root.axis == 1) {
                        Screen.lock-scroll = true;
                    }
                }
                if (root.axis == 1 && !root.hop.is-exit) {
                    root.swipe-dx = self.mouse-x - root.pressed-x;
                }
            }
        }
    }
}

component ExtraExitCard inherits Rectangle {
    in property <ExtraExit> item;
    border-radius: 14px;
    background: Theme.sf2;
    min-height: 56px;
    HorizontalLayout {
        padding-right: 6px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            HopBody {
                label: item.label;
                code: item.code;
                rtt: item.lat;
                is-exit: true;
                mark: "";
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                Ic { kind: "close"; size: 13px; tint: Theme.t2; }
                TouchArea { clicked => { AppState.drop-exit(item.id); } }
            }
        }
    }
}

component AddRow inherits Rectangle {
    in property <string> label;
    in property <string> count;
    callback clicked();
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.ln;
    background: t.pressed ? Theme.sf2 : transparent;
    HorizontalLayout {
        padding: 12px;
        padding-left: 13px;
        padding-right: 13px;
        spacing: 11px;
        VerticalLayout { alignment: center; Ic { kind: "plus"; size: 14px; tint: Theme.a1; sw: 2px; } }
        Text { text: root.label; font-size: 12px; font-weight: 600; color: Theme.a1; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.count; font-size: 10px; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
    }
    t := TouchArea { clicked => { root.clicked(); } }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.ln;
}

export component RouteView inherits VerticalLayout {
    spacing: 16px;
    property <int> drag-idx: -1;
    property <length> drag-dy: 0px;
    // На мобильном граф выносится в интерактивный оверлей ВНЕ скролла (см.
    // mobile_shell), поэтому здесь рисуем только заглушку-место. На desktop мышь
    // работает в скролле, там граф инлайн.
    in property <bool> overlay-globe: false;
    // Позиция и ширина места графа внутри контента (для позиционирования оверлея).
    out property <length> globe-x: card.x + gph.x;
    out property <length> globe-y: card.y + gph.y;
    out property <length> globe-w: gph.width;
    out property <length> globe-h: gph.height;

    ScreenTitle { text: Str.route; }

    card := Card {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 10px;
                Text { text: AppState.hops-count; font-size: 12px; font-weight: 600; color: Theme.t2; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: 999px;
                    border-width: 1px;
                    border-color: AppState.mode-optimal ? Theme.ok : Theme.a1;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        Text {
                            text: AppState.route-mode-label;
                            font-size: 9.5px;
                            font-weight: 600;
                            letter-spacing: 0.8px;
                            font-family: "IBM Plex Mono";
                            color: AppState.mode-optimal ? Theme.ok : Theme.a1;
                        }
                    }
                }
                Text { text: AppState.path-sum; font-size: 13px; font-weight: 600; font-family: "IBM Plex Mono"; color: Theme.ok; vertical-alignment: center; }
            }

            Rectangle {
                height: 42px;
                border-radius: 12px;
                background: Theme.sf2;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;
                    for p[i] in AppState.prios: Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 9px;
                        background: p.selected ? Theme.sf : transparent;
                        Text { text: p.name; font-size: 11px; font-weight: 600; color: p.selected ? Theme.t : Theme.t2; }
                        TouchArea { clicked => { AppState.set-prio(i); } }
                    }
                }
            }

            Divider {}

            Rectangle {
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.ln;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 9px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; border-width: 2px; border-color: Theme.t2; }
                    }
                    Text { text: Str.first-hop-mask; font-size: 11px; color: Theme.t2; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: AppState.transport-code; font-size: 10px; font-weight: 700; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
                }
            }

            if AppState.no-relays: Rectangle {
                horizontal-stretch: 1;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.wn;
                VerticalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    Text {
                        text: AppState.empty-title;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.wn;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: AppState.empty-body;
                        font-size: 11px;
                        color: Theme.t2;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }

            Rectangle {
                height: AppState.draft-hops.length * 62px - 6px;
                for hop[i] in AppState.draft-hops: DraftHopCard {
                    hop: hop;
                    idx: i;
                    drag-idx: root.drag-idx;
                    drag-dy: root.drag-dy;
                    n-relays: AppState.draft-hops.length - 1;
                    start-drag(x) => {
                        root.drag-idx = x;
                        root.drag-dy = 0px;
                        Screen.lock-scroll = true;
                    }
                    move-drag(dy) => {
                        root.drag-dy = dy;
                    }
                    end-drag() => {
                        AppState.hop-reorder(root.drag-idx, max(0, min(AppState.draft-hops.length - 2, root.drag-idx + round(root.drag-dy / 62px))));
                        root.drag-idx = -1;
                        root.drag-dy = 0px;
                        Screen.lock-scroll = false;
                    }
                }
            }

            if AppState.has-extra-exits: VerticalLayout {
                spacing: 6px;
                for xe in AppState.extra-exits: ExtraExitCard { item: xe; }
            }

            if AppState.path-estimated: Text {
                text: AppState.path-warn;
                font-size: 11px;
                color: Theme.wn;
                wrap: word-wrap;
            }

            if AppState.can-add-hop: VerticalLayout {
                spacing: 6px;
                AddRow {
                    label: Str.add-hop;
                    count: AppState.add-free-count;
                    clicked => { AppState.open-add-hop(); }
                }
                AddRow {
                    label: Str.add-exit;
                    count: AppState.exits-count;
                    clicked => { AppState.open-add-exit(); }
                }
            }

            Divider {}

            Text { text: Str.route-graph-title; font-size: 12.5px; font-weight: 700; color: Theme.t; }
            gph := Rectangle {
                height: min(self.width, 560px) * 280 / 300;
                // Desktop: инлайн-граф прямо тут (мышь в скролле работает).
                // Mobile: пусто — граф рисует оверлей поверх этого места.
                if !root.overlay-globe: GlobeView {
                    width: min(parent.width, 560px);
                    x: (parent.width - self.width) / 2;
                }
            }
            Text { text: Str.map-legend; font-size: 10px; color: Theme.t2; wrap: word-wrap; }
        }
    }
}

// Страница маршрута для мобильного: скролл с карточками + ИНТЕРАКТИВНЫЙ граф
// оверлеем ПОВЕРХ скролла (вне Flickable), позиция которого привязана к месту-
// заглушке в потоке. Так граф скроллится вместе с контентом, не является sticky,
// и его TouchArea вне арбитража Flickable — забирает ВСЕ касания (в т.ч. один
// палец) без «зажатия». Мимо графа касания проходят к скроллу.
export component RoutePage inherits Rectangle {
    clip: true;
    scr := BouncyScroll {
        width: 100%;
        height: 100%;
        show-scrollbar: !Screen.mobile-target;
        VerticalLayout {
            width: parent.width;
            padding-left: 20px + Screen.safe-left;
            padding-right: 20px + Screen.safe-right;
            padding-top: 22px + Screen.safe-top;
            padding-bottom: 28px;
            rv := RouteView {
                overlay-globe: true;
            }
        }
    }

    GlobeView {
        width: min(rv.globe-w, 560px);
        x: (20px + Screen.safe-left) + rv.globe-x + (rv.globe-w - self.width) / 2;
        y: (22px + Screen.safe-top) + rv.globe-y + scr.offset-y;
    }
}
