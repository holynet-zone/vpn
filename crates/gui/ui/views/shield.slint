import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle, ToggleRow } from "../widgets/tiles.slint";

export component ShieldView inherits VerticalLayout {
    spacing: 18px;

    ScreenTitle { text: Str.protection; }

    Card {
        border-radius: 22px;
        VerticalLayout {
            padding: 17px;
            spacing: 13px;
            HorizontalLayout {
                Text { text: Str.who-sees; font-size: 14px; font-weight: 700; color: Theme.t; horizontal-stretch: 1; }
                Text { text: AppState.hops-count; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
            }
            for v in AppState.visibility: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: v.who;
                    width: 66px;
                    font-size: 10.5px;
                    font-weight: 600;
                    font-family: "IBM Plex Mono";
                    color: v.level == 0 ? Theme.wn : v.level == 1 ? Theme.ok : Theme.t2;
                    wrap: word-wrap;
                }
                Text { text: v.what; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Text { text: AppState.privacy-note; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
        }
    }

    Card {
        elevated: false;
        border-radius: 20px;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: Str.factors-title; font-size: 11.5px; font-weight: 600; color: Theme.t2; }
            for f in AppState.factors: HorizontalLayout {
                spacing: 9px;
                Text {
                    text: f.mark;
                    width: 12px;
                    font-size: 12px;
                    font-weight: 700;
                    font-family: "IBM Plex Mono";
                    color: f.level == 0 ? Theme.wn : f.level == 1 ? Theme.ok : Theme.t2;
                }
                Text { text: f.name; font-size: 12px; font-weight: 500; color: Theme.t; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
    }

    VerticalLayout {
        spacing: 8px;
        for tg in AppState.toggles: ToggleRow {
            title: tg.name;
            hint: tg.hint;
            on: tg.on;
            toggled => { AppState.flip-toggle(tg.id); }
        }
    }

    Card {
        elevated: false;
        border-radius: 16px;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 15px;
            padding-bottom: 15px;
            spacing: 12px;
            Text { text: Str.split-title; font-size: 14px; font-weight: 600; color: Theme.t; vertical-alignment: center; horizontal-stretch: 1; }
            Text { text: AppState.split-summary; font-size: 12.5px; color: Theme.t2; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    Path {
                        width: 7px;
                        height: 12px;
                        viewbox-width: 7;
                        viewbox-height: 12;
                        stroke: Theme.t2;
                        stroke-width: 1.5px;
                        commands: "M 1.5 1.5 L 5.5 6 L 1.5 10.5";
                        y: -2px;
                    }
                }
            }
        }
        TouchArea { clicked => { Screen.go(Page.split); } }
    }
}
