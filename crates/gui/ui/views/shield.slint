import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle, SectionLabel, ToggleRow } from "../widgets/tiles.slint";

export component ShieldView inherits VerticalLayout {
    spacing: 18px;

    ScreenTitle { text: Str.protection; }

    Card {
        border-radius: 22px;
        VerticalLayout {
            padding: 17px;
            spacing: 13px;
            HorizontalLayout {
                Text { text: Str.who-sees; font-size: 14px; font-weight: 700; color: Theme.t; horizontal-stretch: 1; }
                Text { text: AppState.hops-count; font-size: 10.5px; font-family: "IBM Plex Mono"; color: Theme.t2; vertical-alignment: center; }
            }
            for v in AppState.visibility: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: v.who;
                    width: 66px;
                    font-size: 10.5px;
                    font-weight: 600;
                    font-family: "IBM Plex Mono";
                    color: v.level == 0 ? Theme.wn : v.level == 1 ? Theme.ok : Theme.t2;
                    wrap: word-wrap;
                }
                Text { text: v.what; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; horizontal-stretch: 1; }
            }
            Text { text: AppState.privacy-note; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
        }
    }

    Card {
        elevated: false;
        border-radius: 20px;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text { text: Str.factors-title; font-size: 11.5px; font-weight: 600; color: Theme.t2; }
            for f in AppState.factors: HorizontalLayout {
                spacing: 9px;
                Text {
                    text: f.mark;
                    width: 12px;
                    font-size: 12px;
                    font-weight: 700;
                    font-family: "IBM Plex Mono";
                    color: f.level == 0 ? Theme.wn : f.level == 1 ? Theme.ok : Theme.t2;
                }
                Text { text: f.name; font-size: 12px; font-weight: 500; color: Theme.t; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
    }

    VerticalLayout {
        spacing: 8px;
        for tg in AppState.toggles: ToggleRow {
            title: tg.name;
            hint: tg.hint;
            on: tg.on;
            toggled => { AppState.flip-toggle(tg.id); }
        }
    }

    HorizontalLayout {
        SectionLabel { text: Str.split-title; }
        Rectangle {}
        Text { text: AppState.split-summary; font-size: 11px; color: Theme.t2; }
    }

    VerticalLayout {
        spacing: 8px;
        for a[i] in AppState.apps: Card {
            elevated: false;
            border-radius: 16px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 12px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 10px;
                    background: Theme.sf2;
                    Text { text: a.letter; font-size: 13px; font-weight: 700; color: Theme.t2; }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: a.name; font-size: 13px; font-weight: 600; color: Theme.t; }
                }
                Rectangle {}
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        border-radius: 999px;
                        border-width: 1px;
                        border-color: a.tunneled ? Theme.ok : Theme.ln;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            Text {
                                text: a.tunneled ? Str.tunnel-in : Str.tunnel-out;
                                font-size: 10.5px;
                                color: a.tunneled ? Theme.ok : Theme.t2;
                                font-family: "IBM Plex Mono";
                            }
                        }
                    }
                }
            }
            TouchArea { clicked => { AppState.flip-app(i); } }
        }
    }
}
