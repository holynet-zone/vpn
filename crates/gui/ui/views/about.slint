import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle, SectionLabel, BackButton, MenuLabel, MenuRow } from "../widgets/tiles.slint";
import { Ic } from "../widgets/icons.slint";

component Spinner inherits Rectangle {
    width: 13px;
    height: 13px;
    property <float> ms: animation-tick() / 1ms;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.ln;
    }
    Rectangle {
        width: 100%;
        height: 100%;
        transform-rotation: root.ms * 0.6deg;
        Rectangle {
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.a1;
            x: parent.width / 2 - self.width / 2;
            y: -1px;
        }
    }
}

export component AboutView inherits VerticalLayout {
    spacing: 22px;

    if !Screen.mobile-target: BackButton {
        text: AppState.about-back-label;
        clicked => { AppState.about-back(); }
    }

    if !AppState.about-doc-open: VerticalLayout {
        spacing: 22px;

        VerticalLayout {
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: 24px;
                    background: @linear-gradient(145deg, Theme.a1, Theme.a2);
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        border-width: 3.5px;
                        border-color: Theme.on;
                        y: parent.height / 2 - self.height / 2 - 3px;
                    }
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.on;
                        y: parent.height / 2 - self.height / 2 - 13px;
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout { alignment: center; Text { text: "HolyNet"; font-size: 26px; font-weight: 800; color: Theme.t; } }
                HorizontalLayout { alignment: center; Text { text: AppState.about-version-line; font-size: 11px; font-family: "IBM Plex Mono"; color: Theme.t2; } }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    height: 40px;
                    border-radius: 999px;
                    background: Theme.sf;
                    border-width: 1px;
                    border-color: AppState.about-update-state == 2 ? Theme.ok : Theme.ln;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        if AppState.about-update-state == 1: VerticalLayout { alignment: center; Spinner {} }
                        if AppState.about-update-state == 2: VerticalLayout {
                            alignment: center;
                            Ic { kind: "check"; size: 12px; tint: Theme.ok; sw: 2px; }
                        }
                        Text {
                            text: AppState.about-update-label;
                            font-size: 12px;
                            font-weight: 600;
                            color: AppState.about-update-state == 2 ? Theme.ok : Theme.t;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea { clicked => { AppState.about-check-update(); } }
                }
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: AppState.about-pitch;
                    font-size: 12.5px;
                    color: Theme.t2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 300px;
                }
            }
        }

        VerticalLayout {
            spacing: 7px;
            MenuLabel { text: Str.about-grp-open; }
            Card {
                elevated: false;
                border-radius: 16px;
                VerticalLayout {
                    MenuRow { title: Str.about-src; value: AppState.gh-short; value-mono: true; trail: "ext"; clicked => { AppState.open-url("https://github.com/holynet/holynet"); } }
                    MenuRow { title: Str.about-report; trail: "ext"; top-border: true; clicked => { AppState.open-url("https://github.com/holynet/holynet/issues/new/choose"); } }
                    MenuRow { title: Str.about-changelog; trail: "ext"; top-border: true; clicked => { AppState.open-url("https://github.com/holynet/holynet/releases"); } }
                    MenuRow { title: Str.about-license; value: "GPL-3.0"; value-mono: true; top-border: true; clicked => { AppState.about-open-doc(3); } }
                }
            }
        }

        VerticalLayout {
            spacing: 7px;
            MenuLabel { text: Str.about-grp-legal; }
            Card {
                elevated: false;
                border-radius: 16px;
                VerticalLayout {
                    for d in AppState.about-legal: MenuRow {
                        title: d.title;
                        top-border: d.top-border;
                        clicked => { AppState.about-open-doc(d.key); }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            HorizontalLayout { alignment: center; Text { text: Str.about-copyright; font-size: 11px; color: Theme.t2; horizontal-alignment: center; wrap: word-wrap; } }
            Rectangle {
                height: 18px;
                HorizontalLayout { alignment: center; Text { text: "holynet.app"; font-size: 11px; font-weight: 600; font-family: "IBM Plex Mono"; color: Theme.a1; } }
                TouchArea { clicked => { AppState.open-url("https://holynet.app"); } }
            }
        }
    }

    if AppState.about-doc-open: VerticalLayout {
        spacing: 22px;

        VerticalLayout {
            spacing: 8px;
            ScreenTitle { text: AppState.doc-title; font-size: 26px; }
            Text { text: AppState.doc-updated; font-size: 11px; font-family: "IBM Plex Mono"; color: Theme.t2; }
        }

        Rectangle {
            border-radius: 16px;
            background: Theme.sf2;
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text { text: Str.about-tldr; font-size: 10px; font-weight: 700; font-family: "IBM Plex Mono"; color: Theme.a1; }
                Text { text: AppState.doc-tldr; font-size: 14.5px; font-weight: 600; color: Theme.t; wrap: word-wrap; }
            }
        }

        VerticalLayout {
            spacing: 22px;
            for sec in AppState.doc-sections: HorizontalLayout {
                spacing: 14px;
                Text { text: sec.n; width: 20px; font-size: 11px; font-weight: 600; font-family: "IBM Plex Mono"; color: Theme.t2; }
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text { text: sec.h; font-size: 14.5px; font-weight: 700; color: Theme.t; wrap: word-wrap; }
                    Text { text: sec.p; font-size: 13px; color: Theme.t2; wrap: word-wrap; }
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            Rectangle {
                height: 48px;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.ln;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text { text: Str.about-full-github; font-size: 12.5px; font-weight: 600; color: Theme.t; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Ic { kind: "ext"; size: 12px; } }
                }
                TouchArea { clicked => { AppState.open-url(AppState.doc-url); } }
            }
            Rectangle {
                height: 18px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    Text { text: Str.about-questions; font-size: 11px; color: Theme.t2; vertical-alignment: center; }
                    Text { text: "legal@holynet.app"; font-size: 11px; color: Theme.a1; vertical-alignment: center; }
                }
                TouchArea { clicked => { AppState.open-url("mailto:legal@holynet.app"); } }
            }
        }
    }
}
