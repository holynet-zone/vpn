import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle, LinkRow } from "../widgets/tiles.slint";

export component MoreView inherits VerticalLayout {
    spacing: 18px;

    ScreenTitle { text: Str.settings; }

    Card {
        border-radius: 22px;
        HorizontalLayout {
            padding: 17px;
            spacing: 14px;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: @conic-gradient(Theme.a1 0deg, Theme.a2 180deg, Theme.a1 360deg);
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: Str.account; font-size: 15px; font-weight: 700; color: Theme.t; }
                Text { text: Str.plan; font-size: 12px; color: Theme.t2; }
            }
        }
    }

    LinkRow {
        title: Str.proto-settings;
        subtitle: AppState.proto-summary;
        clicked => { Screen.go(Page.proto); }
    }

    LinkRow {
        title: Str.devices;
        subtitle: AppState.dev-summary;
        clicked => { Screen.go(Page.devices); }
    }

    LinkRow {
        title: Str.appearance;
        subtitle: Str.palette-hint;
        clicked => { Screen.go(Page.settings); }
    }

    LinkRow {
        title: Str.diagnostics;
        subtitle: Str.soon;
        enabled: false;
    }

    LinkRow {
        title: Str.about;
        subtitle: Str.soon;
        enabled: false;
    }
}
