import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Page } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { ScreenTitle, SectionLabel, BackButton } from "../widgets/tiles.slint";

component RadioDot inherits Rectangle {
    in property <bool> on;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: on ? Theme.a1 : Theme.ln;
    Rectangle {
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: on ? Theme.a1 : transparent;
    }
}

export component ProtoView inherits VerticalLayout {
    spacing: 18px;

    if !Screen.wide: BackButton {
        text: Str.back;
        clicked => { Screen.go(Page.more); }
    }

    ScreenTitle { text: Str.proto-settings; font-size: 25px; }

    Card {
        border-radius: 20px;
        VerticalLayout {
            padding: 17px;
            spacing: 14px;
            SectionLabel { text: Str.failover-chain; }
            HorizontalLayout {
                spacing: 6px;
                for c in AppState.chain: HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Rectangle {
                        border-radius: 13px;
                        background: c.active ? Theme.sf2 : transparent;
                        border-width: 1px;
                        border-color: c.active ? Theme.a1 : Theme.ln;
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Text {
                                text: c.code;
                                horizontal-alignment: center;
                                font-size: 11px;
                                font-weight: 700;
                                color: c.active ? Theme.t : Theme.t2;
                                font-family: "IBM Plex Mono";
                            }
                        }
                    }
                    if !c.last: Rectangle {
                        width: 14px;
                        height: 2px;
                        border-radius: 1px;
                        background: Theme.ln;
                    }
                }
            }
            Text { text: Str.failover-hint; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
        }
    }

    VerticalLayout {
        spacing: 9px;
        SectionLabel { text: Str.transport; }
        for tr in AppState.transports: Card {
            elevated: false;
            border-radius: 18px;
            stroke: tr.selected ? Theme.a1 : Theme.ln;
            HorizontalLayout {
                padding: 14px;
                spacing: 13px;
                Rectangle {
                    width: 44px;
                    height: 32px;
                    border-radius: 9px;
                    background: Theme.sf2;
                    Text {
                        text: tr.name;
                        font-size: 10.5px;
                        font-weight: 600;
                        color: tr.selected ? Theme.a1 : Theme.t2;
                        font-family: "IBM Plex Mono";
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: tr.title; font-size: 13px; font-weight: 600; color: Theme.t; }
                    Text { text: tr.desc; font-size: 11.5px; color: Theme.t2; wrap: word-wrap; }
                }
                Rectangle {}
                VerticalLayout { alignment: center; RadioDot { on: tr.selected; } }
            }
            TouchArea { clicked => { AppState.select-transport(tr.id); } }
        }
    }

    VerticalLayout {
        spacing: 9px;
        SectionLabel { text: Str.cipher; }
        HorizontalLayout {
            spacing: 8px;
            for c[i] in AppState.ciphers: Card {
                elevated: false;
                border-radius: 16px;
                stroke: c.selected ? Theme.a1 : Theme.ln;
                background: c.selected ? Theme.sf2 : Theme.sf;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 13px;
                    spacing: 5px;
                    Text {
                        text: c.name;
                        font-size: 11.5px;
                        font-weight: 600;
                        color: c.selected ? Theme.t : Theme.t2;
                        font-family: "IBM Plex Mono";
                    }
                    Text { text: c.hint; font-size: 10.5px; color: Theme.t2; wrap: word-wrap; }
                }
                TouchArea { clicked => { AppState.select-cipher(i); } }
            }
        }
    }

    Card {
        border-radius: 20px;
        VerticalLayout {
            padding: 16px;
            spacing: 11px;
            for p in AppState.proto-rows: HorizontalLayout {
                spacing: 12px;
                Text { text: p.key; font-size: 12.5px; color: Theme.t2; }
                Rectangle {}
                Text { text: p.value; font-size: 12px; color: Theme.t; font-family: "IBM Plex Mono"; }
            }
        }
    }

    Rectangle {
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.wn;
        VerticalLayout {
            padding: 14px;
            Text {
                text: Str.simulate;
                horizontal-alignment: center;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.wn;
            }
        }
        TouchArea { clicked => { AppState.simulate(); Screen.go(Page.home); } }
    }
}
