import { Theme } from "../theme.slint";
import { Str } from "../strings.slint";
import { AppState } from "../state.slint";
import { Screen } from "../screen.slint";
import { Page, ServerInfo } from "../models.slint";
import { Card } from "../widgets/card.slint";
import { SignalBars } from "../widgets/signal_bars.slint";
import { ScreenTitle, IconTag } from "../widgets/tiles.slint";

component NodeCard inherits Card {
    in property <ServerInfo> server;
    elevated: false;
    border-radius: 16px;
    stroke: server.selected ? Theme.a1 : Theme.ln;
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 11px;
        IconTag { text: server.code; width: 34px; height: 34px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: server.city; font-size: 13px; font-weight: 600; color: Theme.t; }
            Text { text: server.meta; font-size: 11px; color: Theme.t2; }
        }
        Rectangle {}
        VerticalLayout { alignment: center; SignalBars { quality: server.quality; } }
        VerticalLayout {
            alignment: center;
            Text { text: server.ping; width: 44px; horizontal-alignment: right; font-size: 10.5px; color: Theme.t2; font-family: "IBM Plex Mono"; }
        }
    }
    TouchArea { clicked => { AppState.select-server(server.id); Screen.go(Page.home); } }
}

export component DesktopNodesView inherits VerticalLayout {
    spacing: 15px;
    alignment: start;

    HorizontalLayout {
        vertical-stretch: 0;
        VerticalLayout {
            alignment: center;
            ScreenTitle { text: Str.nodes; font-size: 23px; }
        }
        Rectangle {}
        Card {
            elevated: false;
            border-radius: 12px;
            width: 248px;
            height: 40px;
            HorizontalLayout {
                padding-left: 13px;
                padding-right: 13px;
                spacing: 9px;
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 12px; height: 12px; border-radius: 6px; border-width: 1.5px; border-color: Theme.t2; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    if AppState.query == "": Text { text: Str.search-ph; color: Theme.t2; font-size: 12.5px; x: 0; vertical-alignment: center; }
                    TextInput {
                        text <=> AppState.query;
                        vertical-alignment: center;
                        font-size: 12.5px;
                        color: Theme.t;
                        single-line: true;
                        width: 100%;
                        height: 100%;
                        edited => { AppState.query-changed(self.text); }
                    }
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 0;
        border-radius: 16px;
        background: @linear-gradient(135deg, Theme.a1, Theme.a2);
        HorizontalLayout {
            padding: 16px;
            spacing: 13px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: #00000030;
                    Rectangle { width: 12px; height: 12px; background: #ffffff; border-radius: 3px; transform-rotation: 45deg; }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text { text: Str.smart; font-size: 13.5px; font-weight: 700; color: Theme.on; }
                Text { text: Str.smart-hint; font-size: 11.5px; color: Theme.on; opacity: 0.82; wrap: word-wrap; }
            }
        }
        TouchArea { clicked => { AppState.smart-pick(); Screen.go(Page.home); } }
    }

    // Двухколоночная сетка. Репитер нельзя класть прямо в GridLayout
    // (Slint: RepeatedItemTree::grid_layout_input_data not implemented),
    // поэтому позиционируем карточки фиксированной высоты вручную.
    grid := Rectangle {
        vertical-stretch: 0;
        property <length> gap: 9px;
        property <length> card-h: 58px;
        property <length> col-w: (self.width - self.gap) / 2;
        height: floor((AppState.servers.length + 1) / 2) * (self.card-h + self.gap) - self.gap;
        for s[i] in AppState.servers: NodeCard {
            server: s;
            width: grid.col-w;
            height: grid.card-h;
            x: mod(i, 2) * (grid.col-w + grid.gap);
            y: floor(i / 2) * (grid.card-h + grid.gap);
        }
    }
}
