export enum ConnStatus { off, connecting, on }
export enum Page { home, route, nodes, shield, more, proto, devices, settings }
export enum RouteTab { auto, manual, graph }
export enum AddStep { idle, parsed, error }

export struct NodeRow {
    id: string,
    code: string,
    city: string,
    group: string,
    meta: string,
    ping: string,
    node-state: int,
    quality: int,
    tag: string,
    selected: bool,
    alive: bool,
}

export struct RouteHop {
    num: int,
    code: string,
    label: string,
    note: string,
    rtt: string,
    rtt-warn: bool,
    is-exit: bool,
    can-up: bool,
    can-down: bool,
    can-drop: bool,
    can-swap: bool,
}

export struct EdgeRow {
    pair: string,
    val: string,
    edge-state: int,
}

export struct PrioTab {
    name: string,
    selected: bool,
}

export struct RouteSeg {
    id: string,
    name: string,
    selected: bool,
}

export struct SpaceRow {
    id: string,
    name: string,
    note: string,
    ctl: string,
    fp: string,
    current: bool,
}

export struct Visibility {
    who: string,
    what: string,
    level: int,
}

export struct Factor {
    mark: string,
    name: string,
    level: int,
}

export struct AddHopChip {
    id: string,
    code: string,
    label: string,
    rtt: string,
}

export struct GlobeNode {
    id: string,
    code: string,
    lat: float,
    lon: float,
    rtt: int,
    stale: bool,
    is-me: bool,
}

export struct ServerInfo {
    id: string,
    code: string,
    city: string,
    meta: string,
    ping: string,
    quality: int,
    selected: bool,
}

export struct TransportInfo {
    id: string,
    name: string,
    title: string,
    desc: string,
    selected: bool,
}

export struct CipherInfo {
    name: string,
    hint: string,
    selected: bool,
}

export struct ChainStep {
    code: string,
    active: bool,
    last: bool,
}

export struct ToggleInfo {
    id: string,
    name: string,
    hint: string,
    on: bool,
}

export struct SplitApp {
    name: string,
    letter: string,
    tunneled: bool,
}

export struct DeviceInfo {
    kind: string,
    name: string,
    meta: string,
    tag: string,
    state: int,
}

export struct KeyValue {
    key: string,
    value: string,
}

export struct PaletteCard {
    id: int,
    name: string,
    hint: string,
    sw1: brush,
    sw2: brush,
    base: brush,
    selected: bool,
}
